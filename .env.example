BOT_TOKEN=
ADMIN_IDS=123456789
GROUP_ID=-1001234567890
# Optional separate VIP group; leave empty to use the main group.
VIP_GROUP_ID=
REQUIRED_CHANNEL_ID=
SUPPORT_TEXT=Поддержка: @your_support. Оплата относится к доступу. Бронь не является покупкой подарка.
DB_PATH=data/tracker.db
CONFIG_PATH=config.json
SOURCE=telegram
# Free guest event feed from see.tg. Set false to disable.
SEE_FEED_ENABLED=true
# Optional See.tg API token. API lookups can spend the daily quota; leave disabled to avoid all REST requests.
SEE_API_TOKEN=
SEE_API_LOOKUPS_ENABLED=false
# Target interval for a sweep of ALL collections, without overlapping sweeps.
# Actual time depends on pagination and Telegram limits and may exceed 5 seconds.
POLL_SECONDS=5
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/market.session
# Optional HTTP proxy for Bot API (requires --use-env-proxy in launch command).
HTTPS_PROXY=
# Optional HTTP/SOCKS proxy for MTProto, e.g. http://127.0.0.1:10809
TELEGRAM_PROXY_URL=
ADMIN_LOGIN_PORT=8765
# Empty = all collections with resale availability; or a comma-separated list of base gift IDs.
MARKET_GIFT_IDS=
MARKET_PAGE_SIZE=100
MARKET_MAX_PAGES=1
MARKET_REQUEST_DELAY_MS=1000
# false = first scan is a baseline, do not flood the group with old listings.
MARKET_PUBLISH_EXISTING=false
# Public seller profiles for the free owner index; also editable through the admin panel.
OWNER_PUBLIC_PROFILES=
OWNER_MAX_PROFILES=10000
# Discover profiles explicitly referenced by public gifts, without paid APIs.
OWNER_AUTO_DISCOVERY=true
